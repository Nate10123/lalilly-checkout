# Cache policy for Cloudflare Pages.
#
# store.js drives product data, pricing, and cart logic — it changes
# whenever products/prices are updated, so browsers should always check
# back with the server instead of serving a stale cached copy. This is
# what caused the "only works in incognito" issue: without this file,
# some browsers cached store.js longer than intended.
/store.js
  Cache-Control: no-cache

# Same reasoning for the main pages — content and prices shown there can
# change, so always revalidate rather than serving a stale cached page.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/shop.html
  Cache-Control: no-cache
/product.html
  Cache-Control: no-cache

# Product/collection images rarely change once uploaded, so these are
# safe to cache aggressively for performance.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
